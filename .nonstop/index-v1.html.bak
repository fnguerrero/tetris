<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>TETRIS</title>
<style>
  :root{
    --bg:#0a0b14; --bg2:#12142a; --grid:#1c1f3d; --line:#242850;
    --txt:#e8ecff; --dim:#7c85b8; --accent:#00e5ff; --accent2:#ff2fb3;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{
    background:radial-gradient(circle at 50% 0%,#1a1d3d 0%,var(--bg) 60%);
    color:var(--txt);
    font-family:"Segoe UI",system-ui,sans-serif;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    min-height:100dvh;overflow:hidden;padding:10px;gap:10px;
    -webkit-tap-highlight-color:transparent;
  }
  h1{
    font-size:clamp(20px,5vw,34px);letter-spacing:.5em;font-weight:800;
    background:linear-gradient(90deg,var(--accent),var(--accent2));
    -webkit-background-clip:text;background-clip:text;color:transparent;
    text-indent:.5em;
  }
  #game{display:flex;gap:14px;align-items:flex-start}
  .side{display:flex;flex-direction:column;gap:10px;width:clamp(84px,17vw,124px)}
  .box{
    background:linear-gradient(180deg,rgba(28,31,61,.9),rgba(18,20,42,.9));
    border:1px solid var(--line);border-radius:10px;padding:8px;
  }
  .box h2{
    font-size:10px;letter-spacing:.18em;color:var(--dim);
    text-transform:uppercase;font-weight:700;margin-bottom:6px;text-align:center;
  }
  .box .val{font-size:clamp(15px,3.4vw,21px);font-weight:800;text-align:center;font-variant-numeric:tabular-nums}
  .box .val.small{font-size:14px}
  .box canvas{display:block;margin:0 auto;max-width:100%}
  #boardWrap{position:relative;border-radius:12px;overflow:hidden;
    border:1px solid var(--line);box-shadow:0 0 60px rgba(0,229,255,.09),0 18px 50px rgba(0,0,0,.6)}
  canvas{display:block;background:transparent}
  #board{height:min(74dvh,640px);width:auto;background:#12142a}
  #overlay{
    position:absolute;inset:0;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:10px;text-align:center;
    background:rgba(8,9,20,.86);backdrop-filter:blur(3px);padding:16px;
  }
  #overlay.hidden{display:none}
  #ovTitle{font-size:clamp(20px,4.6vw,30px);font-weight:800;letter-spacing:.1em}
  #ovText{font-size:12px;color:var(--dim);line-height:1.8;max-width:230px}
  #ovText b{color:var(--txt)}
  .btn{
    margin-top:6px;padding:9px 22px;border-radius:999px;border:0;cursor:pointer;
    font-weight:800;letter-spacing:.09em;font-size:12px;color:#08101a;
    background:linear-gradient(90deg,var(--accent),var(--accent2));
  }
  .btn:active{transform:scale(.96)}
  #msg{
    position:absolute;top:16%;left:0;right:0;text-align:center;pointer-events:none;
    font-size:clamp(14px,3.2vw,20px);font-weight:800;letter-spacing:.08em;
    color:var(--accent);text-shadow:0 0 18px rgba(0,229,255,.6);opacity:0;
  }
  #msg.show{animation:pop 1s ease-out forwards}
  @keyframes pop{0%{opacity:0;transform:translateY(12px) scale(.9)}
    18%{opacity:1;transform:translateY(0) scale(1)}80%{opacity:1}100%{opacity:0}}
  #hint{font-size:10.5px;color:var(--dim);letter-spacing:.06em;text-align:center}
  #hint kbd{background:#1c1f3d;border:1px solid var(--line);border-radius:4px;
    padding:1px 5px;font-family:inherit;font-size:10px;color:var(--txt)}
  #touch{display:none;gap:8px;width:100%;max-width:440px}
  #touch button{
    flex:1;padding:14px 0;border-radius:10px;border:1px solid var(--line);
    background:#171a34;color:var(--txt);font-size:17px;font-weight:700;cursor:pointer;
  }
  #touch button:active{background:#242850}
  #sound{position:absolute;top:10px;right:12px;background:none;border:0;color:var(--dim);
    cursor:pointer;font-size:15px;padding:4px}
  @media (max-width:620px),(pointer:coarse){
    #touch{display:flex}
    #hint{display:none}
    #board{height:min(56dvh,520px)}
    #game{gap:8px}
    .side{width:70px}
  }
</style>
</head>
<body>
<button id="sound" title="Sonido">&#128266;</button>
<h1>TETRIS</h1>

<div id="game">
  <div class="side">
    <div class="box"><h2>Hold</h2><canvas id="hold" width="110" height="76"></canvas></div>
    <div class="box"><h2>Score</h2><div class="val" id="score">0</div></div>
    <div class="box"><h2>R&eacute;cord</h2><div class="val small" id="best">0</div></div>
  </div>

  <div id="boardWrap">
    <canvas id="board"></canvas>
    <div id="msg"></div>
    <div id="overlay">
      <div id="ovTitle">TETRIS</div>
      <div id="ovText"></div>
      <button class="btn" id="startBtn">JUGAR</button>
    </div>
  </div>

  <div class="side">
    <div class="box"><h2>Next</h2><canvas id="next" width="110" height="220"></canvas></div>
    <div class="box"><h2>Nivel</h2><div class="val" id="level">1</div></div>
    <div class="box"><h2>L&iacute;neas</h2><div class="val" id="lines">0</div></div>
  </div>
</div>

<div id="touch">
  <button data-act="left">&#9664;</button>
  <button data-act="rotL">&#8630;</button>
  <button data-act="rotR">&#8631;</button>
  <button data-act="hold">H</button>
  <button data-act="down">&#9660;</button>
  <button data-act="drop">&#8681;</button>
  <button data-act="right">&#9654;</button>
</div>

<div id="hint">
  <kbd>&#8592;</kbd><kbd>&#8594;</kbd> mover &nbsp;&middot;&nbsp; <kbd>&#8595;</kbd> bajar &nbsp;&middot;&nbsp;
  <kbd>&#8593;</kbd>/<kbd>X</kbd> rotar &nbsp;&middot;&nbsp; <kbd>Z</kbd> rotar al rev&eacute;s &nbsp;&middot;&nbsp;
  <kbd>Space</kbd> rotar &nbsp;&middot;&nbsp; <kbd>Enter</kbd> ca&iacute;da &nbsp;&middot;&nbsp; <kbd>C</kbd> hold &nbsp;&middot;&nbsp; <kbd>P</kbd> pausa &nbsp;&middot;&nbsp; <kbd>R</kbd> reiniciar
</div>

<script>
(function(){
'use strict';

/* ---------- Constantes ---------- */
var COLS = 10, ROWS = 20, HIDDEN = 2;        // 2 filas ocultas arriba para el spawn
var TOTAL_ROWS = ROWS + HIDDEN;
var DAS = 150, ARR = 40, SOFT = 45, LOCK_DELAY = 500, MAX_RESETS = 15, CLEAR_MS = 220;
var CELL = 32;                                // resolucion interna; el CSS escala

var COLORS = {I:'#00e5ff',J:'#3d6bff',L:'#ff9f1c',O:'#ffe14d',S:'#3ddc84',T:'#c04dff',Z:'#ff4d5e'};

// Celdas [x,y] por estado de rotacion (0=spawn, 1=CW, 2=180, 3=CCW)
var SHAPES = {
  I:[[[0,1],[1,1],[2,1],[3,1]],[[2,0],[2,1],[2,2],[2,3]],[[0,2],[1,2],[2,2],[3,2]],[[1,0],[1,1],[1,2],[1,3]]],
  J:[[[0,0],[0,1],[1,1],[2,1]],[[1,0],[2,0],[1,1],[1,2]],[[0,1],[1,1],[2,1],[2,2]],[[1,0],[1,1],[0,2],[1,2]]],
  L:[[[2,0],[0,1],[1,1],[2,1]],[[1,0],[1,1],[1,2],[2,2]],[[0,1],[1,1],[2,1],[0,2]],[[0,0],[1,0],[1,1],[1,2]]],
  O:[[[1,0],[2,0],[1,1],[2,1]],[[1,0],[2,0],[1,1],[2,1]],[[1,0],[2,0],[1,1],[2,1]],[[1,0],[2,0],[1,1],[2,1]]],
  S:[[[1,0],[2,0],[0,1],[1,1]],[[1,0],[1,1],[2,1],[2,2]],[[1,1],[2,1],[0,2],[1,2]],[[0,0],[0,1],[1,1],[1,2]]],
  T:[[[1,0],[0,1],[1,1],[2,1]],[[1,0],[1,1],[2,1],[1,2]],[[0,1],[1,1],[2,1],[1,2]],[[1,0],[0,1],[1,1],[1,2]]],
  Z:[[[0,0],[1,0],[1,1],[2,1]],[[2,0],[1,1],[2,1],[1,2]],[[0,1],[1,1],[1,2],[2,2]],[[1,0],[0,1],[1,1],[0,2]]]
};

// Wall kicks SRS, con la Y ya invertida (positivo = hacia abajo en pantalla)
var KICKS = {
  '0>1':[[0,0],[-1,0],[-1,-1],[0,2],[-1,2]],
  '1>0':[[0,0],[1,0],[1,1],[0,-2],[1,-2]],
  '1>2':[[0,0],[1,0],[1,1],[0,-2],[1,-2]],
  '2>1':[[0,0],[-1,0],[-1,-1],[0,2],[-1,2]],
  '2>3':[[0,0],[1,0],[1,-1],[0,2],[1,2]],
  '3>2':[[0,0],[-1,0],[-1,1],[0,-2],[-1,-2]],
  '3>0':[[0,0],[-1,0],[-1,1],[0,-2],[-1,-2]],
  '0>3':[[0,0],[1,0],[1,-1],[0,2],[1,2]]
};
var KICKS_I = {
  '0>1':[[0,0],[-2,0],[1,0],[-2,1],[1,-2]],
  '1>0':[[0,0],[2,0],[-1,0],[2,-1],[-1,2]],
  '1>2':[[0,0],[-1,0],[2,0],[-1,-2],[2,1]],
  '2>1':[[0,0],[1,0],[-2,0],[1,2],[-2,-1]],
  '2>3':[[0,0],[2,0],[-1,0],[2,-1],[-1,2]],
  '3>2':[[0,0],[-2,0],[1,0],[-2,1],[1,-2]],
  '3>0':[[0,0],[1,0],[-2,0],[1,2],[-2,-1]],
  '0>3':[[0,0],[-1,0],[2,0],[-1,-2],[2,1]]
};

/* ---------- DOM ---------- */
var boardCv = document.getElementById('board'), bctx = boardCv.getContext('2d');
var nextCv  = document.getElementById('next'),  nctx = nextCv.getContext('2d');
var holdCv  = document.getElementById('hold'),  hctx = holdCv.getContext('2d');
var elScore = document.getElementById('score'), elLevel = document.getElementById('level');
var elLines = document.getElementById('lines'), elBest  = document.getElementById('best');
var overlay = document.getElementById('overlay'), ovTitle = document.getElementById('ovTitle');
var ovText  = document.getElementById('ovText'), startBtn = document.getElementById('startBtn');
var msgEl   = document.getElementById('msg'), soundBtn = document.getElementById('sound');

boardCv.width  = COLS * CELL;
boardCv.height = ROWS * CELL;

/* ---------- Estado ---------- */
var grid, piece, nextQueue, bag, hold, holdUsed, state;
var score, lines, level, combo, backToBack, lastAction, lastKick;
var dropTimer, lockTimer, lockResets, clearAnim;
// localStorage puede no estar disponible (origen opaco, modo privado): nunca debe romper el juego
var store = {
  get: function(k, def){ try{ var v = localStorage.getItem(k); return v === null ? def : v; }catch(e){ return def; } },
  set: function(k, v){ try{ localStorage.setItem(k, String(v)); }catch(e){} }
};
var best = Number(store.get('tetris.best', '0')) || 0;
var soundOn = store.get('tetris.sound', '1') !== '0';

/* ---------- Sonido: blips cortos, sin loops ---------- */
var actx = null;
function beep(freq, dur, type, vol){
  if(!soundOn) return;
  try{
    if(!actx) actx = new (window.AudioContext || window.webkitAudioContext)();
    if(actx.state === 'suspended') actx.resume();
    var o = actx.createOscillator(), g = actx.createGain();
    o.type = type || 'square';
    o.frequency.value = freq;
    g.gain.setValueAtTime(vol || 0.05, actx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.0001, actx.currentTime + dur);
    o.connect(g); g.connect(actx.destination);
    o.start(); o.stop(actx.currentTime + dur);
  }catch(e){ /* sin audio disponible */ }
}

/* ---------- Utilidades ---------- */
function emptyGrid(){
  var g = [];
  for(var y = 0; y < TOTAL_ROWS; y++) g.push(new Array(COLS).fill(null));
  return g;
}
function refillBag(){
  var p = ['I','J','L','O','S','T','Z'];
  for(var i = p.length - 1; i > 0; i--){
    var j = Math.floor(Math.random() * (i + 1));
    var t = p[i]; p[i] = p[j]; p[j] = t;
  }
  bag = bag.concat(p);
}
function nextType(){
  if(bag.length < 7) refillBag();
  return bag.shift();
}
function cellsOf(p, rot, x, y){
  var r  = (rot === undefined) ? p.rot : rot;
  var px = (x === undefined) ? p.x : x;
  var py = (y === undefined) ? p.y : y;
  return SHAPES[p.type][r].map(function(c){ return [c[0] + px, c[1] + py]; });
}
function valid(p, rot, x, y){
  return cellsOf(p, rot, x, y).every(function(c){
    var cx = c[0], cy = c[1];
    return cx >= 0 && cx < COLS && cy < TOTAL_ROWS && (cy < 0 || !grid[cy][cx]);
  });
}
function gravityMs(){
  var t = Math.pow(0.8 - (level - 1) * 0.007, level - 1) * 1000;
  return Math.max(t, 25);
}

/* ---------- Piezas ---------- */
function spawn(type){
  piece = { type: type, rot: 0, x: 3, y: 0 };
  holdUsed = false; lastAction = null; lastKick = 0;
  dropTimer = 0; lockTimer = null; lockResets = 0;
  while(nextQueue.length < 3) nextQueue.push(nextType());
  drawNext(); drawHold();
  if(!valid(piece)) gameOver();
}
function shiftQueue(){
  var t = nextQueue.shift();
  while(nextQueue.length < 3) nextQueue.push(nextType());
  return t;
}
function move(dx){
  if(valid(piece, piece.rot, piece.x + dx, piece.y)){
    piece.x += dx;
    lastAction = 'move';
    if(lockTimer !== null) resetLock();
    beep(180, 0.03, 'square', 0.03);
    return true;
  }
  return false;
}
function softDrop(){
  if(valid(piece, piece.rot, piece.x, piece.y + 1)){
    piece.y++; score += 1; lastAction = 'move';
    lockTimer = null; lockResets = 0;
    updateHUD();
    return true;
  }
  startLock();
  return false;
}
function hardDrop(){
  var d = 0;
  while(valid(piece, piece.rot, piece.x, piece.y + 1)){ piece.y++; d++; }
  score += d * 2;
  updateHUD();
  beep(90, 0.07, 'sawtooth', 0.06);
  lockPiece();
}
function rotate(dir){
  if(piece.type === 'O') return;
  var from = piece.rot, to = (from + dir + 4) % 4;
  var table = (piece.type === 'I') ? KICKS_I : KICKS;
  var kicks = table[from + '>' + to] || [[0,0]];
  for(var i = 0; i < kicks.length; i++){
    var kx = kicks[i][0], ky = kicks[i][1];
    if(valid(piece, to, piece.x + kx, piece.y + ky)){
      piece.rot = to; piece.x += kx; piece.y += ky;
      lastAction = 'rotate'; lastKick = i;
      if(lockTimer !== null) resetLock();
      beep(320, 0.035, 'square', 0.035);
      return;
    }
  }
}
function doHold(){
  if(holdUsed) return;
  var cur = piece.type;
  if(hold){ var h = hold; hold = cur; spawn(h); }
  else { hold = cur; spawn(shiftQueue()); }
  holdUsed = true;
  drawHold();
  beep(420, 0.05, 'triangle', 0.04);
}
function startLock(){ if(lockTimer === null){ lockTimer = 0; } }
function resetLock(){ if(lockResets < MAX_RESETS){ lockTimer = 0; lockResets++; } }

/* ---------- T-spin (regla de las 3 esquinas) ---------- */
function isTSpin(){
  if(piece.type !== 'T' || lastAction !== 'rotate') return null;
  var corners = [[0,0],[2,0],[0,2],[2,2]];
  var front = {0:[0,1], 1:[1,3], 2:[2,3], 3:[0,2]}[piece.rot];
  var filled = 0, frontFilled = 0;
  for(var i = 0; i < corners.length; i++){
    var cx = piece.x + corners[i][0], cy = piece.y + corners[i][1];
    var occ = cx < 0 || cx >= COLS || cy >= TOTAL_ROWS || (cy >= 0 && !!grid[cy][cx]);
    if(occ){ filled++; if(front.indexOf(i) !== -1) frontFilled++; }
  }
  if(filled < 3) return null;
  return (frontFilled === 2 || lastKick === 4) ? 'full' : 'mini';
}

/* ---------- Bloqueo y limpieza ---------- */
function lockPiece(){
  var tspin = isTSpin();
  var cells = cellsOf(piece);
  var outside = cells.every(function(c){ return c[1] < HIDDEN; });

  cells.forEach(function(c){ if(c[1] >= 0) grid[c[1]][c[0]] = piece.type; });

  var full = [];
  for(var y = 0; y < TOTAL_ROWS; y++){
    if(grid[y].every(function(c){ return !!c; })) full.push(y);
  }

  if(full.length){
    scoreLines(full.length, tspin);
    clearAnim = { rows: full, t: 0 };
    state = 'clearing';
    return;
  }

  if(outside) return gameOver();   // bloqueo enteramente arriba del tablero

  if(tspin){
    score += (tspin === 'mini' ? 100 : 400) * level;
    flash(tspin === 'mini' ? 'T-SPIN MINI' : 'T-SPIN');
    updateHUD();
  }
  combo = -1;
  spawn(shiftQueue());
}

function scoreLines(n, tspin){
  var base = tspin
    ? (tspin === 'mini' ? [0,200,400,600,800] : [0,800,1200,1600,2000])
    : [0,100,300,500,800];
  var pts = base[n] * level;
  var hard = (n === 4) || !!tspin;
  if(hard && backToBack) pts = Math.floor(pts * 1.5);
  var wasB2B = backToBack;
  backToBack = hard;

  combo++;
  if(combo > 0) pts += 50 * combo * level;

  score += pts;
  lines += n;

  var newLevel = Math.floor(lines / 10) + 1;
  if(newLevel > level){
    level = newLevel;
    flash('NIVEL ' + level);
    beep(660, 0.12, 'triangle', 0.06);
  } else if(tspin){
    flash('T-SPIN' + (tspin === 'mini' ? ' MINI' : '') +
          (n === 1 ? ' SINGLE' : n === 2 ? ' DOUBLE' : ' TRIPLE'));
  } else if(n === 4){
    flash(wasB2B ? 'TETRIS B2B!' : 'TETRIS!');
  } else if(combo > 0){
    flash('COMBO x' + combo);
  }

  beep(n === 4 ? 720 : 480, 0.12, 'triangle', 0.06);
  updateHUD();
}

function finishClear(){
  clearAnim.rows.sort(function(a,b){ return a - b; }).forEach(function(y){
    grid.splice(y, 1);
    grid.unshift(new Array(COLS).fill(null));
  });
  clearAnim = null;
  state = 'playing';
  spawn(shiftQueue());
}

/* ---------- Fin de partida ---------- */
function gameOver(){
  state = 'over';
  var record = score > best;
  if(record){ best = score; store.set('tetris.best', best); }
  updateHUD();
  beep(160, 0.3, 'sawtooth', 0.07);
  ovTitle.textContent = 'GAME OVER';
  ovText.innerHTML = 'Score <b>' + score + '</b><br>L&iacute;neas <b>' + lines +
                     '</b> &middot; Nivel <b>' + level + '</b>' +
                     (record ? '<br>Nuevo r&eacute;cord' : '');
  startBtn.textContent = 'JUGAR DE NUEVO';
  overlay.classList.remove('hidden');
}

/* ---------- HUD ---------- */
function updateHUD(){
  elScore.textContent = score;
  elLines.textContent = lines;
  elLevel.textContent = level;
  elBest.textContent  = best;
}
var msgTimer;
function flash(text){
  msgEl.textContent = text;
  msgEl.classList.remove('show');
  void msgEl.offsetWidth;
  msgEl.classList.add('show');
  clearTimeout(msgTimer);
  msgTimer = setTimeout(function(){ msgEl.classList.remove('show'); }, 1000);
}

/* ---------- Dibujo ---------- */
function roundRect(ctx, x, y, w, h, r){
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
  ctx.closePath();
}
function shade(hex, amt){
  var n = parseInt(hex.slice(1), 16);
  var r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
  r = Math.round(Math.min(255, Math.max(0, r + r * amt)));
  g = Math.round(Math.min(255, Math.max(0, g + g * amt)));
  b = Math.round(Math.min(255, Math.max(0, b + b * amt)));
  return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
}
function block(ctx, x, y, size, color, alpha, ghost){
  var p = Math.max(1, size * 0.06);
  ctx.save();
  ctx.globalAlpha = (alpha === undefined) ? 1 : alpha;
  if(ghost){
    ctx.strokeStyle = color;
    ctx.lineWidth = Math.max(1.5, size * 0.09);
    roundRect(ctx, x + p, y + p, size - p * 2, size - p * 2, size * 0.18);
    ctx.stroke();
  } else {
    var g = ctx.createLinearGradient(x, y, x, y + size);
    g.addColorStop(0, color);
    g.addColorStop(1, shade(color, -0.32));
    ctx.fillStyle = g;
    roundRect(ctx, x + p, y + p, size - p * 2, size - p * 2, size * 0.18);
    ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,.22)';
    roundRect(ctx, x + p * 2, y + p * 2, size - p * 4, (size - p * 4) * 0.34, size * 0.12);
    ctx.fill();
  }
  ctx.restore();
}

function drawBoard(){
  bctx.fillStyle = '#12142a';
  bctx.fillRect(0, 0, boardCv.width, boardCv.height);

  bctx.strokeStyle = '#1c1f3d';
  bctx.lineWidth = 1;
  for(var x = 1; x < COLS; x++){
    bctx.beginPath(); bctx.moveTo(x * CELL + 0.5, 0);
    bctx.lineTo(x * CELL + 0.5, boardCv.height); bctx.stroke();
  }
  for(var y = 1; y < ROWS; y++){
    bctx.beginPath(); bctx.moveTo(0, y * CELL + 0.5);
    bctx.lineTo(boardCv.width, y * CELL + 0.5); bctx.stroke();
  }

  for(var gy = HIDDEN; gy < TOTAL_ROWS; gy++){
    for(var gx = 0; gx < COLS; gx++){
      var t = grid[gy][gx];
      if(!t) continue;
      var a = 1;
      if(clearAnim && clearAnim.rows.indexOf(gy) !== -1) a = Math.max(0, 1 - clearAnim.t / CLEAR_MS);
      block(bctx, gx * CELL, (gy - HIDDEN) * CELL, CELL, COLORS[t], a);
    }
  }

  if(piece && (state === 'playing' || state === 'paused')){
    var ghostY = piece.y;
    while(valid(piece, piece.rot, piece.x, ghostY + 1)) ghostY++;
    cellsOf(piece, piece.rot, piece.x, ghostY).forEach(function(c){
      if(c[1] >= HIDDEN) block(bctx, c[0] * CELL, (c[1] - HIDDEN) * CELL, CELL, COLORS[piece.type], 0.4, true);
    });
    cellsOf(piece).forEach(function(c){
      if(c[1] >= HIDDEN) block(bctx, c[0] * CELL, (c[1] - HIDDEN) * CELL, CELL, COLORS[piece.type]);
    });
  }
}

function drawMini(ctx, type, cx, cy, size){
  if(!type) return;
  var cells = SHAPES[type][0];
  var xs = cells.map(function(c){ return c[0]; });
  var ys = cells.map(function(c){ return c[1]; });
  var minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
  var minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
  var w = (maxX - minX + 1) * size, h = (maxY - minY + 1) * size;
  var ox = cx - w / 2 - minX * size, oy = cy - h / 2 - minY * size;
  cells.forEach(function(c){ block(ctx, ox + c[0] * size, oy + c[1] * size, size, COLORS[type]); });
}
function drawNext(){
  nctx.clearRect(0, 0, nextCv.width, nextCv.height);
  var slot = nextCv.height / 3;
  nextQueue.slice(0, 3).forEach(function(t, i){
    drawMini(nctx, t, nextCv.width / 2, slot * i + slot / 2, 21);
  });
}
function drawHold(){
  hctx.clearRect(0, 0, holdCv.width, holdCv.height);
  hctx.globalAlpha = holdUsed ? 0.35 : 1;
  drawMini(hctx, hold, holdCv.width / 2, holdCv.height / 2, 21);
  hctx.globalAlpha = 1;
}

/* ---------- Input ---------- */
var keys = {};
var repeat = { dir: 0, timer: 0, started: false };
var softTimer = 0;

document.addEventListener('keydown', function(e){
  var k = e.key.toLowerCase();
  if(['arrowleft','arrowright','arrowdown','arrowup',' ','enter'].indexOf(k) !== -1) e.preventDefault();

  if(k === 'p' || k === 'escape'){ togglePause(); return; }
  if(k === 'r'){ startGame(); return; }
  if(state !== 'playing'){
    if(k === 'enter' || k === ' '){
      if(state === 'paused') togglePause(); else if(state !== 'clearing') startGame();
    }
    return;
  }
  if(keys[k]) return;
  keys[k] = true;

  if(k === 'arrowleft'){ repeat.dir = -1; repeat.timer = 0; repeat.started = false; move(-1); }
  else if(k === 'arrowright'){ repeat.dir = 1; repeat.timer = 0; repeat.started = false; move(1); }
  else if(k === 'arrowdown'){ softTimer = 0; softDrop(); }
  else if(k === 'arrowup' || k === 'x' || k === ' '){ rotate(1); }
  else if(k === 'z' || k === 'control'){ rotate(-1); }
  else if(k === 'enter'){ hardDrop(); }
  else if(k === 'c' || k === 'shift'){ doHold(); }
});

document.addEventListener('keyup', function(e){
  var k = e.key.toLowerCase();
  keys[k] = false;
  if((k === 'arrowleft' && repeat.dir === -1) || (k === 'arrowright' && repeat.dir === 1)) repeat.dir = 0;
});

document.getElementById('touch').addEventListener('pointerdown', function(e){
  var btn = e.target.closest('button');
  if(!btn) return;
  e.preventDefault();
  if(state !== 'playing'){
    if(state === 'paused') togglePause();
    else if(state !== 'clearing') startGame();
    return;
  }
  var a = btn.getAttribute('data-act');
  if(a === 'left') move(-1);
  else if(a === 'right') move(1);
  else if(a === 'down') softDrop();
  else if(a === 'drop') hardDrop();
  else if(a === 'rotL') rotate(-1);
  else if(a === 'rotR') rotate(1);
  else if(a === 'hold') doHold();
});

startBtn.addEventListener('click', function(){
  if(state === 'paused') togglePause(); else startGame();
});
soundBtn.addEventListener('click', function(){
  soundOn = !soundOn;
  store.set('tetris.sound', soundOn ? '1' : '0');
  soundBtn.innerHTML = soundOn ? '&#128266;' : '&#128263;';
});
document.addEventListener('visibilitychange', function(){
  if(document.hidden){
    if(state === 'playing') togglePause();
    if(actx && actx.state === 'running') actx.suspend();
  }
});

function togglePause(){
  if(state === 'playing'){
    state = 'paused';
    ovTitle.textContent = 'PAUSA';
    ovText.innerHTML = 'Score <b>' + score + '</b>';
    startBtn.textContent = 'CONTINUAR';
    overlay.classList.remove('hidden');
  } else if(state === 'paused'){
    state = 'playing';
    overlay.classList.add('hidden');
  }
}

/* ---------- Partida ---------- */
function startGame(){
  grid = emptyGrid();
  bag = []; nextQueue = []; hold = null; holdUsed = false;
  score = 0; lines = 0; level = 1; combo = -1; backToBack = false;
  clearAnim = null; repeat.dir = 0; keys = {};
  state = 'playing';
  overlay.classList.add('hidden');
  refillBag();
  while(nextQueue.length < 3) nextQueue.push(nextType());
  spawn(shiftQueue());
  updateHUD();
}

/* ---------- Loop ---------- */
var last = 0;
function loop(ts){
  var dt = last ? Math.min(ts - last, 100) : 0;
  last = ts;

  if(state === 'playing'){
    if(repeat.dir !== 0){
      repeat.timer += dt;
      if(!repeat.started && repeat.timer >= DAS){ repeat.started = true; repeat.timer = 0; move(repeat.dir); }
      else if(repeat.started && repeat.timer >= ARR){ repeat.timer = 0; move(repeat.dir); }
    }
    if(keys['arrowdown']){
      softTimer += dt;
      while(softTimer >= SOFT){ softTimer -= SOFT; softDrop(); }
    }

    if(state === 'playing'){
      var grounded = !valid(piece, piece.rot, piece.x, piece.y + 1);
      if(grounded){
        startLock();
        lockTimer += dt;
        if(lockTimer >= LOCK_DELAY) lockPiece();
      } else {
        lockTimer = null;
        dropTimer += dt;
        var g = gravityMs();
        while(dropTimer >= g){
          dropTimer -= g;
          if(valid(piece, piece.rot, piece.x, piece.y + 1)){ piece.y++; lastAction = 'move'; }
          else { startLock(); break; }
        }
      }
    }
  } else if(state === 'clearing'){
    clearAnim.t += dt;
    if(clearAnim.t >= CLEAR_MS) finishClear();
  }

  drawBoard();
  requestAnimationFrame(loop);
}

/* ---------- Init ---------- */
grid = emptyGrid();
bag = []; nextQueue = []; hold = null; holdUsed = false;
score = 0; lines = 0; level = 1; combo = -1; backToBack = false;
clearAnim = null; state = 'ready';
soundBtn.innerHTML = soundOn ? '&#128266;' : '&#128263;';
ovTitle.textContent = 'TETRIS';
ovText.innerHTML = 'Flechas para mover &middot; <b>Space</b> rotar<br>' +
                   '<b>Enter</b> ca&iacute;da r&aacute;pida &middot; <b>C</b> guardar pieza<br>' +
                   '<b>P</b> pausa &middot; <b>R</b> reiniciar';
updateHUD(); drawNext(); drawHold(); drawBoard();
requestAnimationFrame(loop);

})();
</script>
</body>
</html>
